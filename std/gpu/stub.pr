//! Placeholder for `std.gpu` (§14.11): the type names the compiler knows
//! (§11.1.2, §11.1.3) and the error, feature and limit types.
//!
//! Declarations only. The real modules (`device`, `buffer`, `texture`,
//! `accel`, `render`, ...) replace this file in later tasks.

/// Sampled 2D texture with texel format `F` (binding resource).
pub struct Texture2D<F> {}
/// Sampled 3D texture (binding resource).
pub struct Texture3D<F> {}
/// Cube-map texture (binding resource).
pub struct TextureCube<F> {}
/// Array of 2D textures (binding resource).
pub struct Texture2DArray<F> {}
/// Depth texture (binding resource).
pub struct DepthTexture2D {}
/// Storage texture; a `mut` parameter may write it (binding resource).
pub struct StorageTexture2D<F> {}
/// Texture sampler (binding resource).
pub struct Sampler {}
/// Top-level acceleration structure (binding resource, §11.5.1).
pub struct Tlas {}
/// Inline ray query (GPU-local type, §11.5.5).
pub struct RayQuery {}
/// Mesh-stage output (GPU-local type, §11.4.3).
pub struct MeshOut<V, Prim, VM, PM> {}

/// Why a GPU operation failed.
pub enum GpuError {
    no_device, unsupported, limits, device_lost, out_of_memory,
    stale_buffer, stale_blas, bad_geometry, invalid_instance, surface_lost,
}

/// Optional device features. All fields are `bool`.
pub struct Features {
    pub mesh_shaders: bool, pub ray_tracing: bool, pub ray_query: bool,
    pub ray_primitive_culling: bool, pub fragment_stores: bool,
    pub shader_f64: bool, pub shader_i64: bool, pub storage_8bit: bool, pub storage_16bit: bool,
}

/// Device limits. Portable minimums are in §11.1.1, §11.4.5 and §11.5.
pub struct Limits {
    pub max_compute_invocations: u32, pub max_task_invocations: u32, pub max_mesh_invocations: u32,
    pub max_mesh_vertices: u32, pub max_mesh_primitives: u32, pub max_task_payload: u32,
    pub max_mesh_output_bytes: u32, pub max_task_mesh_grid: u32, pub max_ray_recursion: u32,
    pub max_ray_payload: u32, pub max_hit_attributes: u32, pub max_tlas_instances: u32,
    pub max_dispatch_per_dim: u32, pub max_color_targets: u32,
}
