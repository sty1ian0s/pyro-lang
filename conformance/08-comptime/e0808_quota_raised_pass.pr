//@ covers: E0808
// §8.6: `@set_eval_quota` raises the budget of the evaluation it runs in, and
// the budget is per top-level evaluation.

fn count_up(n: u64) -> u64 {
    let mut i: u64 = 0;
    while i < n { i += 1; }
    i
}

const BIG: u64 = comptime {
    @set_eval_quota(30_000_000);
    count_up(20_000_000)
};

const A: u64 = count_up(6_000_000);
const B: u64 = count_up(6_000_000);
