//@ expected-fail: T072
// §8.4.2: a `FieldId<T>` literal is checked against `T`'s fields.

struct Monster { health: f32, threat: u32 }

fn sort_key<T>(xs: soa []T, comptime f: FieldId<T>, i: usize) -> @field_type(T, f) {
    @field(xs, f)[i]
}

const SPEED: FieldId<Monster> = .speed; //~ E0803

fn key(ms: soa []Monster) -> u32 {
    sort_key(ms, .threat_level, 0) //~ E0803
}
