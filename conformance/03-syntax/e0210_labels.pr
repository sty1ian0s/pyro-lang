//@ covers: E0210
// §3.5: labelled `for`, `while` and `loop`, used from nested loops.
fn find(grid: [][]u32, target: u32) -> bool {
    let mut found = false;
    rows: for row in grid {
        for v in row {
            if v == target { found = true; break :rows; }
            if v > target { continue :rows; }
        }
    }
    found
}

fn drain(mut n: u32) {
    outer: while n > 0 {
        n -= 1;
        scan: loop {
            if n % 2 == 0 { break :scan; }
            continue :outer;
        }
    }
}
