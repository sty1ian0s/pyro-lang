//@ covers: E0209
// §3.5, §2.4.1: `gpu` and `cpu` after `launch`; elsewhere they and `over` are identifiers.
fn kernel(mut xs: []f32) {}

fn run(mut xs: []f32, n: usize) {
    launch gpu kernel(mut xs);
    launch cpu kernel(mut xs);
    launch gpu kernel(mut xs) over 0..n;
    let gpu = 1;
    let cpu = gpu + 1;
    let over = cpu;
}
