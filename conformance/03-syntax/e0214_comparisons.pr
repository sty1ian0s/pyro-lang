//@ covers: E0214
//@ expected-fail: T023
// §3.9: one comparison per level, combined with `&&`/`||` or parentheses.
fn f(a: i32, b: i32, c: i32, p: bool) {
    let x = a < b && b < c;
    let y = (a == b) == p;
    let z = p != (a < b);
    let w = a & 0xff == 0 || a + 1 <= b * 2;
    let r1 = a..b;
    let r2 = a..=b;
    let r3 = a..;
    let r4 = ..b;
    let r5 = ..;
    let r6 = (0..a) == (0..b);
}
