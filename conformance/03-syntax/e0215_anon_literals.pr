//@ covers: E0215
//@ expected-fail: T023
// §3.8: all-named and all-positional `.{…}` literals, the rest marker, empty literals.
fn f(x: i32, y: i32) {
    let a = .{ x: 1, y: 2 };
    let b = .{ 1, 2, };
    let c = .{ x, y };
    let d = .{ x: 1, .. };
    let e = .{ .. };
    let g = .{};
    let h = .{ 1 + 2, x * y };
    let i = .{ sorted_by: .threat, .. };
}
