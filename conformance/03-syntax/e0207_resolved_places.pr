//@ stop-after: check
//@ covers: E0207
//@ expected-fail: T055
// §3.5, §1.6: assignments to resolved places type-check without E0207.
struct Point { x: i32, y: i32 }

fn shift(mut p: Point, d: i32) {
    p.x += d;
    p.y = p.y - d;
}

pub fn main() {
    let mut n: i32 = 0;
    n = 5;
    n *= 2;
    let mut a: [4]i32 = [0; 4];
    a[1] = n;
    let mut p = Point { x: 1, y: 2 };
    p.x = a[1];
    let mut t: (i32, bool) = (1, true);
    t.0 = 3;
    shift(mut p, t.0);
}
