//@ covers: E0504
//@ expected-fail: T123
// §10.3: writes through the element binding and body locals, reads of captured
// variables, `Atomic` methods, unlabelled `continue` and loop exits of inner loops are
// allowed.

@soa
struct Particle { pub mut x: f32, pub mut vx: f32 }

fn step(mut particles: []Particle, dt: f32) {
    parallel_for p in particles {
        p.vx *= 0.99;
        p.x += p.vx * dt;
    }
}

fn count_and_scale(mut xs: []u32, k: u32, nonzero: Atomic<u64>) {
    parallel_for x in xs {
        if x == 0 { continue; }
        let mut scaled = x * k;
        scaled += 1;
        x = scaled;
        _ = nonzero.fetch_add(1);
    }
}

fn inner_loop(mut xs: []u32) {
    parallel_for x in xs {
        for i in 0..4u32 {
            if i == 2 { break; }
            x += i;
        }
    }
}
