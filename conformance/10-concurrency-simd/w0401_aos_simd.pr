//@ expected-fail: T156
// §10.6.4: a `@simd` loop over a non-SoA slice of structs warns. Each loop is on one
// line so the reported line is unambiguous.

struct Body { pub mut x: f32, pub mut vx: f32 }

fn step(mut bodies: []Body, dt: f32) {
    @simd for b in bodies { b.x += b.vx * dt; } //~ W0401
}

fn copy_x(bodies: []Body, mut xs: []f32) {
    @simd for b, i in bodies { xs[i] = b.x; } //~ W0401
}
