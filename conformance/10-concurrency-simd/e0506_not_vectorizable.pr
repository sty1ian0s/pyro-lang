//@ expected-fail: T156
// §10.6.4: a `@simd` loop must be vectorized; a call to a non-inlinable (recursive)
// function, a `break` or a loop-carried dependency makes compilation fail. Each loop
// is on one line so the reported line is unambiguous.

fn halve_until_small(x: f32) -> f32 {
    if x > 1.0 { return halve_until_small(x / 2.0); }
    x
}

fn with_break(mut xs: []f32) {
    @simd for x in xs { if x < 0.0 { break; } x *= 2.0; } //~ E0506
}

fn with_recursive_call(mut xs: []f32) {
    @simd for x in xs { x = halve_until_small(x); } //~ E0506
}

fn with_dependency(mut xs: []f32) {
    let mut prev: f32 = 0.0;
    @simd for x in xs { x += prev; prev = x; } //~ E0506
}
