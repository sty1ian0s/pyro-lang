//@ expected-fail: T051
// §12.1, §12.2, §8.7: each unsafe operation outside `unsafe`. The body of an `@unsafe`
// function is not implicitly an `unsafe` block.

extern "C" {
    pub fn abs(x: i32) -> i32;
}

/// Reads `*p`. The caller guarantees that `p` points to a live, initialized `u32`.
@unsafe
fn read_raw(p: *const u32) -> u32 {
    *p //~ E1202
}

fn all_outside(x: u32, addr: usize) -> u32 {
    let p = &x; //~ E1202
    let q = @ptr_from_int(u32, addr); //~ E1202
    let r = @ptr_add(q, 1); //~ E1202
    let v = *r; //~ E1202
    let w = q[0]; //~ E1202
    let a = abs(-3); //~ E1202
    let b = read_raw(p); //~ E1202
    let flag = @bit_cast(bool, 1 as u8); //~ E1202
    if flag { v + w + b + (a as u32) } else { 0 }
}
