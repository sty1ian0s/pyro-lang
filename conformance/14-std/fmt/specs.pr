//@ expected-fail: T112
// §14.6: `spec ::= [fill align] [width] ['.' precision] [type]`.

pub fn main() {
    print("{:x} {:X} {:b} {:o}\n", 255, 255, 5, 8);
    print("[{:<5}] [{:>5}] [{:^6}]\n", 42, 42, 42);
    print("[{:*<4}] [{:->4}] [{:_^6}]\n", "ab", "ab", "ab");
    print("{:.2} {:.0} {:.3}\n", 3.14159, 2.0, 0.5);
    print("[{:>8.2}] {:0>8x}\n", 3.14159, 48879);
}
