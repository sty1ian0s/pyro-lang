//@ expected-fail: T050
//@ covers: E0325
// §5.3.1: resources may be fields, tuple elements and enum payloads; many
// resources are modelled as plain data plus handles.

@resource
pub struct File {
    fd: i32,

    pub fn open(fd: i32) -> File { File { fd } }
    pub fn close(move self) {}
}

pub enum IoError { closed }

struct Rack {
    main: File,
    spare: (File, u32),
    ids: [4]i32,
}

fn first(r: Result<File, IoError>) -> bool {
    r.is_ok()
}
