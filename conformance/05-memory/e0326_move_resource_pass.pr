//@ expected-fail: T080
//@ covers: E0326
// §5.5.2: `move` on a resource parameter; a generic `move` parameter
// instantiated with a plain type simply copies.

@resource
pub struct File {
    fd: i32,

    pub fn open(fd: i32) -> File { File { fd } }
    pub fn close(move self) {}
}

fn keep(move f: File) { f.close(); }

fn pass_through<T>(move x: T) -> T { return x; }

fn demo() -> u32 {
    let n = pass_through(7u32);
    let f = pass_through(File.open(1));
    keep(move f);
    n
}
