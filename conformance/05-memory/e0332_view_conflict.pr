//@ expected-fail: T082
// §5.4.2, §6.7.2: while a view is live, its origin cannot be written; a `for`
// iterable stays live for the whole loop.

fn bad(mut arena: Arena) {
    let mut tmp = arena.alloc_slice(u32, 64);
    arena.reset(); //~ E0332
    tmp[0] = 1;
}

fn grow(mut xs: List<u32>) {
    for x in xs {
        xs.push(x); //~ E0332
    }
}

fn read_while_written(mut a: [4]u32) -> u32 {
    let s: []u32 = a[..];
    a[0] = 9; //~ E0332
    s[0]
}
