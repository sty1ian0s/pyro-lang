//@ expected-fail: T183
// §11.1.3: binding resources (textures, samplers, `Tlas`, storage slices) may appear
// only as read-only or `mut` parameters and arguments. They cannot be moved or
// deinitialized. A `move` texture parameter of a stage is a texture-class type in
// the wrong mode: this case reads the specific binding-resource rule of §11.1.3 as
// taking precedence, so it is E1003 only, not also E1001 (§11.1.2), which is for types
// outside every parameter class.

use std.gpu;

@gpu_kernel(workgroup: (8, 8, 1))
fn consumes_texture(
    move tex: gpu.Texture2D<vec4<f32>>, //~ E1003
    mut out: gpu.StorageTexture2D<vec4<f32>>,
) {
    out.store(@global_invocation_id.xy, tex.load(@global_invocation_id.xy, 0));
    tex.deinit(); //~ E1003
}
