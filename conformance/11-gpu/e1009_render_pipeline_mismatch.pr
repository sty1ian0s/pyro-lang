//@ expected-fail: T190
// §11.1.2, §11.3.2, §11.6.1: render-pipeline checks, each reported at the pipeline
// declaration: a stage in the wrong role, a fragment input that is not the varyings
// type, a same-name parameter with different types, both a vertex and a mesh stage, and
// a strip topology with a mesh stage. Each pipeline fails exactly one check, so one
// E1009 is expected per line: the wrong-role pipeline is depth-only, which has no
// fragment input to mismatch.

use std.gpu;

pub struct Vertex { pos: vec3<f32>, uv: vec2<f32> }
pub struct Camera { view_proj: [4]vec4<f32> }
pub struct Light { dir: vec3<f32> }
pub struct VsOut { @position clip: vec4<f32>, uv: vec2<f32> }
pub struct OtherOut { @position clip: vec4<f32>, color: vec3<f32> }

@gpu_vertex
fn vs_basic(v: Vertex, cam: Camera) -> VsOut {
    let m = cam.view_proj;
    VsOut { clip: m[0] * v.pos.x + m[1] * v.pos.y + m[2] * v.pos.z + m[3], uv: v.uv }
}

@gpu_fragment
fn fs_basic(i: VsOut) -> vec4<f32> { vec4(i.uv.x, i.uv.y, 0.0, 1.0) }

@gpu_fragment
fn fs_other(i: OtherOut) -> vec4<f32> { vec4(i.color.x, i.color.y, i.color.z, 1.0) }

@gpu_fragment
fn fs_cam_is_light(i: VsOut, cam: Light) -> vec4<f32> { vec4(cam.dir.x, cam.dir.y, cam.dir.z, 1.0) }

@gpu_mesh(workgroup: 64, max_vertices: 3, max_primitives: 1)
fn ms_triangle(mut out: gpu.MeshOut<VsOut, void, 3, 1>) {
    out.set_counts(3, 1);
    let t = @local_invocation_id.x;
    if t < 3 { out.vertex(t, VsOut { clip: vec4(t as f32, 0.0, 0.0, 1.0), uv: vec2(0.0, 0.0) }); }
    if t < 1 { out.triangle(t, vec3(0, 1, 2)); }
}

const WrongRole = gpu.RenderPipeline(.{ vertex: fs_basic, depth: .{ format: .depth32f, compare: .less, write: true }, .. }); //~ E1009
const WrongInput = gpu.RenderPipeline(.{ vertex: vs_basic, fragment: fs_other, color: [.{ format: .bgra8_srgb, .. }], .. }); //~ E1009
const SplitCamera = gpu.RenderPipeline(.{ vertex: vs_basic, fragment: fs_cam_is_light, color: [.{ format: .bgra8_srgb, .. }], .. }); //~ E1009
const VertexAndMesh = gpu.RenderPipeline(.{ vertex: vs_basic, mesh: ms_triangle, fragment: fs_basic, color: [.{ format: .bgra8_srgb, .. }], .. }); //~ E1009
const StripMesh = gpu.RenderPipeline(.{ mesh: ms_triangle, fragment: fs_basic, topology: .triangle_strip, color: [.{ format: .bgra8_srgb, .. }], .. }); //~ E1009
