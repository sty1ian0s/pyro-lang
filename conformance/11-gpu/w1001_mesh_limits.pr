//@ expected-fail: T197
// §11.4.5: `max_vertices` or `max_primitives` above the portable minimum of 256
// compiles with a warning at the stage attribute.

use std.gpu;

pub struct VsOut { @position clip: vec4<f32> }

@gpu_mesh(workgroup: 128, max_vertices: 300, max_primitives: 1) //~ W1001
fn ms_many_vertices(mut out: gpu.MeshOut<VsOut, void, 300, 1>) {
    out.set_counts(3, 1);
    let t = @local_invocation_id.x;
    if t < 3 { out.vertex(t, VsOut { clip: vec4(t as f32, 0.0, 0.0, 1.0) }); }
    if t < 1 { out.triangle(t, vec3(0, 1, 2)); }
}

@gpu_mesh(workgroup: 128, max_vertices: 3, max_primitives: 512) //~ W1001
fn ms_many_primitives(mut out: gpu.MeshOut<VsOut, void, 3, 512>) {
    out.set_counts(3, 1);
    let t = @local_invocation_id.x;
    if t < 3 { out.vertex(t, VsOut { clip: vec4(t as f32, 0.0, 0.0, 1.0) }); }
    if t < 1 { out.triangle(t, vec3(0, 1, 2)); }
}
