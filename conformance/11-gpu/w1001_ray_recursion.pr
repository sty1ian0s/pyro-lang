//@ expected-fail: T198
// §11.5.2: `max_recursion` above 1 exceeds the portable minimum and compiles with a
// warning at the pipeline declaration.

use std.gpu;

pub struct Shade { color: vec3<f32>, shadowed: bool }

const SUN_DIR: vec3<f32> = .{ 0.3, 0.9, 0.3 };

@gpu_ray_gen
fn rg_camera(scene: gpu.Tlas, mut image: []vec4<f32>) {
    let mut s = Shade { color: vec3(0.0, 0.0, 0.0), shadowed: false };
    gpu.trace_ray(scene, .{ origin: vec3(0.0, 0.0, 0.0), t_min: 0.0, direction: vec3(0.0, 0.0, 1.0), t_max: 100.0 }, mut s);
    image[gpu.linear_id(@launch_id, @launch_size) as usize] = vec4(s.color.x, s.color.y, s.color.z, 1.0);
}

@gpu_miss
fn miss_sky(mut s: Shade, ray: gpu.RayInfo) { s.color = vec3(0.5, 0.7, 1.0); }

@gpu_miss
fn miss_shadow(mut s: Shade, ray: gpu.RayInfo) { s.shadowed = false; }

@gpu_closest_hit
fn hit_lambert(mut s: Shade, hit: gpu.Hit<gpu.Barycentrics>, scene: gpu.Tlas) {
    let p = hit.ray.origin + hit.ray.direction * hit.t;
    s.shadowed = true;
    gpu.trace_ray(scene, .{ origin: p, t_min: 0.001, direction: SUN_DIR, t_max: 1.0e30 }, mut s,
                  .{ miss: 1, flags: .{ terminate_on_first_hit: true, skip_closest_hit: true, .. }, .. });
    s.color = if s.shadowed { vec3(0.1, 0.1, 0.1) } else { vec3(0.9, 0.9, 0.9) };
}

const Shadowed = gpu.RayPipeline(.{ ray_gen: rg_camera, miss: [miss_sky, miss_shadow], hit_groups: [.{ closest: hit_lambert, .. }], max_recursion: 2, .. }); //~ W1001
