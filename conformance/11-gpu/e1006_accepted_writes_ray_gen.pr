//@ covers: E1006
//@ expected-fail: T198
// §11.1.6: a ray-generation stage writes storage at `gpu.linear_id(@launch_id,
// @launch_size) as usize`.

use std.gpu;

@gpu_ray_gen
fn rg_fill(mut image: []vec4<f32>) {
    image[gpu.linear_id(@launch_id, @launch_size) as usize] = vec4(1.0, 0.0, 0.0, 1.0);
}
