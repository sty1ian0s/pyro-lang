//@ covers: E1001
//@ expected-fail: T176
// §11.1.2, §11.2: a kernel returns `void` and takes uniform parameters (scalars,
// vectors, plain structs), storage parameters (`[]T`, `soa []T`, `[]Atomic<u32>`) and,
// when dispatched through a `gpu.ComputePipeline`, textures and samplers.

use std.gpu;

pub struct Params { scale: f32, offset: vec2<f32>, count: u32 }

@soa
pub struct Body { x: f32, y: f32, vx: f32, vy: f32 }

@gpu_kernel(workgroup: 64)
fn uniforms_and_storage(mut out: []f32, xs: []f32, p: Params, k: f32, dir: vec3<f32>) {
    let i = @global_invocation_id.x as usize;
    if i >= out.len() || i >= xs.len() { return; }
    out[i] = xs[i] * p.scale * k + dir.x + p.offset.y;
}

@gpu_kernel(workgroup: 64)
fn soa_storage(mut bodies: soa []Body, dt: f32) {
    let i = @global_invocation_id.x as usize;
    if i >= bodies.len() { return; }
    bodies[i].x += bodies[i].vx * dt;
    bodies[i].y += bodies[i].vy * dt;
}

@gpu_kernel(workgroup: 64)
fn histogram(bins: []Atomic<u32>, xs: []u32) {
    let i = @global_invocation_id.x as usize;
    if i >= xs.len() { return; }
    bins[(xs[i] as usize) % bins.len()].fetch_add(1);
}

@gpu_kernel(workgroup: (8, 8, 1))
fn textured(src: gpu.Texture2D<vec4<f32>>, smp: gpu.Sampler, mut dst: gpu.StorageTexture2D<vec4<f32>>) {
    let c = src.load(@global_invocation_id.xy, 0) + src.sample_level(smp, vec2(0.5, 0.5), 0.0);
    dst.store(@global_invocation_id.xy, c);
}

const Textured = gpu.ComputePipeline(textured);
