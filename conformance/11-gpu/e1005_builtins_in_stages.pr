//@ covers: E1005
//@ expected-fail: T128
// §11.1.7: each builtin variable and builtin function used in a compute, vertex or
// fragment stage that lists it. Task stages are in e1005_builtins_task.pr (T197), ray
// generation in e1005_builtins_ray_gen.pr (T198).

pub struct Vertex { pos: vec3<f32>, uv: vec2<f32> }
pub struct VsOut { @position clip: vec4<f32>, uv: vec2<f32> }

@gpu_kernel(workgroup: 64)
fn ids(mut xs: []u32) {
    let i = @global_invocation_id.x as usize;
    let tag = @local_invocation_id.x + @workgroup_id.x * @num_workgroups.x;
    @workgroup_barrier();
    if i < xs.len() { xs[i] = tag; }
}

@gpu_vertex
fn vs_ids(v: Vertex) -> VsOut {
    let shift = (@vertex_index + @instance_index) as f32 * 0.01;
    VsOut { clip: vec4(v.pos.x + shift, v.pos.y, v.pos.z, 1.0), uv: v.uv }
}

@gpu_fragment
fn fs_builtins(i: VsOut) -> vec4<f32> {
    if !@front_facing { @discard(); }
    let edge = @fwidth(i.uv.x) + @dpdx(i.uv.y) + @dpdy(i.uv.y);
    vec4(@frag_coord.x * edge, @sample_index as f32, 0.0, 1.0)
}
