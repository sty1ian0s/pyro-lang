//@ expected-fail: T197
// §11.1.1, §11.4: this case is the root module of the package beside it, whose
// pyro.toml configures only WebGPU. WebGPU has no mesh shaders, so a mesh stage used by
// the program is an error. The mesh stage is used through `MeshPipe`, so E1004 is
// reported at that pipeline declaration. §11.6.1 also lists feature availability among
// the E1009 pipeline checks; this case reads E1004 (A.3: "not supported by any
// configured backend") as the code for that check. The check is T183's, but the case
// also needs `gpu.RenderPipeline` (T190) and mesh stages (T197), which land last.

use std.gpu;

pub struct VsOut { @position clip: vec4<f32> }

@gpu_mesh(workgroup: 64, max_vertices: 3, max_primitives: 1)
fn ms_triangle(mut out: gpu.MeshOut<VsOut, void, 3, 1>) {
    out.set_counts(3, 1);
    let t = @local_invocation_id.x;
    if t < 3 { out.vertex(t, VsOut { clip: vec4(t as f32, 0.0, 0.0, 1.0) }); }
    if t < 1 { out.triangle(t, vec3(0, 1, 2)); }
}

@gpu_fragment
fn fs_white(i: VsOut) -> vec4<f32> { vec4(1.0, 1.0, 1.0, 1.0) }

const MeshPipe = gpu.RenderPipeline(.{ mesh: ms_triangle, fragment: fs_white, color: [.{ format: .bgra8_srgb, .. }], .. }); //~ E1004

pub fn main() {}
