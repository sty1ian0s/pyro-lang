//@ expected-fail: T183
// §11.1.1, §11.1.3: this case is the root module of the package beside it, whose
// pyro.toml configures only WebGPU. WebGPU has neither mesh shaders nor `f64`, so a
// used mesh stage and `f64` arithmetic in a launched kernel are errors.

use std.gpu;

pub struct VsOut { @position clip: vec4<f32> }

@gpu_mesh(workgroup: 64, max_vertices: 3, max_primitives: 1) //~ E1004
fn ms_triangle(mut out: gpu.MeshOut<VsOut, void, 3, 1>) {
    out.set_counts(3, 1);
    let t = @local_invocation_id.x;
    if t < 3 { out.vertex(t, VsOut { clip: vec4(t as f32, 0.0, 0.0, 1.0) }); }
    if t < 1 { out.triangle(t, vec3(0, 1, 2)); }
}

@gpu_fragment
fn fs_white(i: VsOut) -> vec4<f32> { vec4(1.0, 1.0, 1.0, 1.0) }

const MeshPipe = gpu.RenderPipeline(.{ mesh: ms_triangle, fragment: fs_white, color: [.{ format: .bgra8_srgb, .. }], .. });

@gpu_kernel(workgroup: 64)
fn double(mut xs: []f64) {
    let i = @global_invocation_id.x as usize;
    if i < xs.len() { xs[i] = xs[i] * 2.0; } //~ E1004
}

pub fn main() {
    let mut xs: [4]f64 = [1.0; 4];
    launch gpu double(mut xs[..]);
}
