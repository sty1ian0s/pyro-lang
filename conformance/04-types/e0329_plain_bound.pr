// §7.6.1, §14.4: `T: plain` rejects resource, view and shared-cell types; the
// standard containers declare their element type `plain`.

@resource
pub struct File {
    fd: i32,

    pub fn open(fd: i32) -> File { File { fd } }
    pub fn close(move self) {}
}

struct Pair<T: plain> { pub mut a: T, pub mut b: T }

type Files = Pair<File>; //~ E0329
type Names = Pair<str>; //~ E0329
type Counters = List<Atomic<u32>>; //~ E0329

fn sum(p: Pair<u32>) -> u32 { p.a + p.b }
