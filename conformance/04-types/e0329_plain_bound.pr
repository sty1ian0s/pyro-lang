//@ expected-fail: T064
// §7.6.1, §14.4: `T: plain` rejects resource and view types; the standard
// containers declare their element type `plain`.

@resource
pub struct File {
    fd: i32,

    pub fn open(fd: i32) -> File { File { fd } }
    pub fn close(move self) {}
}

struct Pair<T: plain> { pub mut a: T, pub mut b: T }

type Files = List<File>; //~ E0329
type Names = Pair<str>; //~ E0329

fn keep<T: plain>(x: T) -> T { x }

fn name_len() -> usize {
    let n = keep("orc"); //~ E0329
    3
}
