//@ expected-fail: T048
//@ covers: E0304
// §4.3.2: masks are fine in locals and as operands of `@any`/`@select`.

fn any_closer(a: vec4<f32>, b: vec4<f32>) -> bool {
    let m: mask<4> = a < b;
    let zero: vec4<f32> = @splat(4, 0.0);
    let both = m & (a > zero);
    @any(both)
}

fn nearest(a: vec4<f32>, b: vec4<f32>) -> vec4<f32> {
    let m = a < b;
    @select(m, a, b)
}
