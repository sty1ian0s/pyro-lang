//@ expected-fail: T044
// §7.5.2: a call whose argument type has no `impl` for the bound is rejected at
// the call site.

pub protocol Shape { fn area(self) -> f32; }

struct Square { side: f32 }
impl Shape for Square { fn area(self) -> f32 { self.side * self.side } }

struct Label { width: f32 }

fn total<T: Shape>(xs: []T) -> f32 {
    let mut sum: f32 = 0.0;
    for x in xs { sum += x.area(); }
    sum
}

fn label_area(labels: []Label) -> f32 {
    total(labels) //~ E0373
}
