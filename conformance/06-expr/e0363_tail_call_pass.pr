//@ expected-fail: T078
//@ covers: E0363
// §6.9: tail calls with plain arguments and with views of parameters.

fn sum_to(n: u64, acc: u64) -> u64 {
    if n == 0 { return acc; }
    return tail sum_to(n - 1, acc + n);
}

fn scan(xs: []u32, i: usize, acc: u32) -> u32 {
    if i >= xs.len() { return acc; }
    return tail scan(xs, i + 1, acc + xs[i]);
}
