//@ expected-fail: T135
// §9.5.1: a contract must not write anything, call functions with `mut`
// parameters, or move resources.

@resource
pub struct Token {
    id: u32,

    pub fn release(move self) -> bool { true }
}

pub struct Counter {
    hits: u32,

    pub fn bump(mut self) -> u32 {
        self.hits += 1;
        self.hits
    }

    @requires(self.bump() > 0) //~ E0702
    pub fn reset(mut self) { self.hits = 0; }

    @requires({ self.hits = 0; true }) //~ E0702
    pub fn clear(mut self) { self.hits = 0; }
}

fn zero_first(mut buf: []u8) -> bool {
    if buf.len() == 0 { return false; }
    buf[0] = 0;
    true
}

@requires(zero_first(mut buf)) //~ E0702
pub fn send(mut buf: []u8) { buf[0] = 1; }

@requires(t.release()) //~ E0702
pub fn finish(move t: Token) -> bool { true }
