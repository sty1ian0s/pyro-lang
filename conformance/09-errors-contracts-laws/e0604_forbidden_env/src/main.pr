//@ expected-fail: T140
// §9.2: in an environment with `allow_todo_err = false` (see ../pyro.toml),
// every `@todo_err` is an error, and still also produces W0601.

pub enum ParseError { bad_digit }

fn parse_digit(c: u8) -> Result<u8, ParseError> {
    if c < 48 || c > 57 { return .err(.bad_digit); }
    return .ok(c - 48);
}

pub fn main() {
    let d = @todo_err(parse_digit(55)); //~ E0604 W0601
    print("{}\n", d);
}
