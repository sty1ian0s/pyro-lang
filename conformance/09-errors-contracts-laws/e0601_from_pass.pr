//@ expected-fail: T077
//@ covers: E0601
// §6.12.1: `?` with the same error type needs no conversion; a different error
// type converts through the function error type's `From` impl.

pub enum ParseError { empty, bad_digit }
pub enum ConfigError { missing, parse(ParseError) }

impl From<ParseError> for ConfigError {
    fn from(e: ParseError) -> Self { .parse(e) }
}

fn parse_digit(c: u8) -> Result<u8, ParseError> {
    if c < 48 || c > 57 { return .err(.bad_digit); }
    return .ok(c - 48);
}

fn parse_two(a: u8, b: u8) -> Result<u8, ParseError> {
    let hi = parse_digit(a)?;
    let lo = parse_digit(b)?;
    return .ok(hi * 10 + lo);
}

fn read_digit(c: u8) -> Result<u8, ConfigError> {
    let d = parse_digit(c)?;
    return .ok(d);
}
