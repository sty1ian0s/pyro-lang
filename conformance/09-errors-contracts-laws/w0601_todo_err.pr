//@ expected-fail: T140
// §9.2: every use of `@todo_err` produces W0601, also in environments that
// allow it (`dev`, the environment `pyro check` uses by default).

pub enum ParseError { bad_digit }

fn parse_digit(c: u8) -> Result<u8, ParseError> {
    if c < 48 || c > 57 { return .err(.bad_digit); }
    return .ok(c - 48);
}

fn sum_digits(a: u8, b: u8) -> u8 {
    let x = @todo_err(parse_digit(a)); //~ W0601
    x + @todo_err(parse_digit(b)) //~ W0601
}
